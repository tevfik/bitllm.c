#version 450
/* SigLIP patch merge: per tile, the 32x32 patch grid [1024, D] is regrouped into 8x8 blocks of 4x4 patches,
 * C[tile][block][local * D + d] = A[tile][patch][d] with block = by*8+bx, local = py*4+px, patch = (by*4+py)*32 + bx*4+px. */
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer BufA { float a[]; };
layout(std430, set = 0, binding = 4) buffer BufC { float c[]; };

layout(push_constant) uniform PC {
    uint count, D, a_off, c_off;
} p;

void main()
{
    uint stride = gl_NumWorkGroups.x * 256u;
    for (uint i = gl_GlobalInvocationID.x; i < p.count; i += stride) {
        uint d = i % p.D;
        uint j = i / p.D;
        uint lp = j % 16u;
        uint blk = (j / 16u) % 64u;
        uint t = j / 1024u;
        uint pidx = ((blk / 8u) * 4u + lp / 4u) * 32u + (blk % 8u) * 4u + lp % 4u;
        c[p.c_off + i] = a[p.a_off + (t * 1024u + pidx) * p.D + d];
    }
}
