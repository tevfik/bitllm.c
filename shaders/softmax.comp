#version 450
/* Row-wise softmax in place on C: rows of N elements starting at c_off. */
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 4) buffer BufC { float c[]; };

layout(push_constant) uniform PC {
    uint N, rows, c_off;
} p;

shared float red[256];

void main()
{
    const uint t = gl_LocalInvocationID.x;
    for (uint row = gl_WorkGroupID.x; row < p.rows; row += gl_NumWorkGroups.x) {
        uint base = p.c_off + row * p.N;
        float m = -3.402823e38;
        for (uint i = t; i < p.N; i += 256u) m = max(m, c[base + i]);
        red[t] = m;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1) {
            if (t < s) red[t] = max(red[t], red[t + s]);
            barrier();
        }
        m = red[0];
        barrier();
        float sum = 0.0;
        for (uint i = t; i < p.N; i += 256u) { float e = exp(c[base + i] - m); c[base + i] = e; sum += e; }
        red[t] = sum;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1) {
            if (t < s) red[t] += red[t + s];
            barrier();
        }
        float inv = 1.0 / red[0];
        barrier();
        for (uint i = t; i < p.N; i += 256u) c[base + i] *= inv;
    }
}
